<!--
  Reporm 2 tricycle (24dp), hand-drawn for Sagay City.

  The Reporm 2 is the motorized tricycle used across Negros Occidental: an
  open-sided passenger canopy on three wheels, with a motorcycle front in
  front of it - sloping cowl, handlebar and a single front wheel. It is
  deliberately different in silhouette from Material's "electric_rickshaw"
  glyph, which is a closed three-wheeler with an integral windscreen, so
  the two tricycle services in the app are told apart at a glance.

  Colour is applied at runtime (the route colour of the serving terminal),
  so this single drawable covers the red, yellow and white tricycles.

  Path data is authored for this project; no Material artwork is used here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      Canopy frame: rear pillar, roof, floor and the sloping motorcycle cowl
      that runs down to the handlebar. The open passenger side is cut out
      with an even-odd fill, so the body reads as a roof on pillars rather
      than a solid block.
    -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M1.6,12.4 V5.2 C1.6,4 2.6,3 3.8,3 H12.2 C13.4,3 14.4,3.8 14.7,5 L15.6,9.6 H18.4 V10.8 H15.9 L15.2,12.4 H1.6 Z M3.8,10.8 V5.6 H11.6 V10.8 Z" />
    <!-- Front fork, running from the handlebar down to the front wheel. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M17.4,10.6 H18.8 L20.4,13.6 H19 Z" />
    <!-- Rear wheel. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M4.1,14.8 C4.1,13.64 5.04,12.7 6.2,12.7 C7.36,12.7 8.3,13.64 8.3,14.8 C8.3,15.96 7.36,16.9 6.2,16.9 C5.04,16.9 4.1,15.96 4.1,14.8 Z" />
    <!-- Front wheel. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M16.3,14.9 C16.3,13.74 17.24,12.8 18.4,12.8 C19.56,12.8 20.5,13.74 20.5,14.9 C20.5,16.06 19.56,17 18.4,17 C17.24,17 16.3,16.06 16.3,14.9 Z" />
</vector>
