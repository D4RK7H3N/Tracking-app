# Copy to gradle.properties (gitignored) before building.
# AndroidX is required by Compose, Hilt, Room and the AndroidX test libraries.
android.useAndroidX=true
org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8

# Optional: pin a machine-local JDK 17-21 if the default is unsuitable.
# org.gradle.java.home=/path/to/jdk-21
